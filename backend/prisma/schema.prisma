// This is your Prisma schema file.
// Learn more in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * |--------------------------------------------------------------------------
 * | Enums
 * |--------------------------------------------------------------------------
 */

enum UserStatus {
  EMAIL_UNVERIFIED
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  CORRECTION_REQUIRED
  SUSPENDED
  INACTIVE
  DELETED
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  EVENT_MANAGER
  CONTENT_MANAGER
  ALUMNI
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED
}

enum MemoryStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * |--------------------------------------------------------------------------
 * | User
 * |--------------------------------------------------------------------------
 */

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(255)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  status          UserStatus @default(EMAIL_UNVERIFIED)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relations
  userRoles               UserRole[]
  alumniProfile           AlumniProfile?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  eventsOrganized         Event[]
  eventRegistrations      EventRegistration[]
  memories                Memory[]

  @@map("users")
}

/**
 * |--------------------------------------------------------------------------
 * | Role
 * |--------------------------------------------------------------------------
 */

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      RoleName @unique
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  userRoles UserRole[]

  @@map("roles")
}

/**
 * |--------------------------------------------------------------------------
 * | User Role
 * |--------------------------------------------------------------------------
 */

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/**
 * |--------------------------------------------------------------------------
 * | Email Verification Token
 * |--------------------------------------------------------------------------
 */

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/**
 * |--------------------------------------------------------------------------
 * | Password Reset Token
 * |--------------------------------------------------------------------------
 */

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/**
 * |--------------------------------------------------------------------------
 * | Alumni Profile
 * |--------------------------------------------------------------------------
 */

model AlumniProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Basic Information
  fullName    String    @map("full_name") @db.VarChar(150)
  phone       String?   @db.VarChar(30)
  dateOfBirth DateTime? @map("date_of_birth")
  gender      String?   @db.VarChar(30)
  bio         String?   @db.Text

  // Academic Information
  batchId        String @map("batch_id") @db.Uuid
  graduationYear Int    @map("graduation_year")

  university String @db.VarChar(200)
  department String @db.VarChar(200)

  // Professional Information
  profession   String? @db.VarChar(150)
  organization String? @db.VarChar(200)
  designation  String? @db.VarChar(150)

  // Location
  city    String? @db.VarChar(100)
  country String? @db.VarChar(100)

  // Profile Photo
  profilePhotoUrl String? @map("profile_photo_url") @db.VarChar(500)

  // Social Links
  linkedinUrl String? @map("linkedin_url") @db.VarChar(500)
  facebookUrl String? @map("facebook_url") @db.VarChar(500)
  githubUrl   String? @map("github_url") @db.VarChar(500)
  websiteUrl  String? @map("website_url") @db.VarChar(500)

  // Privacy
  isDirectoryVisible Boolean @default(true) @map("is_directory_visible")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchRecord Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([fullName])
  @@index([batchId])
  @@index([graduationYear])
  @@index([university])
  @@index([department])
  @@index([profession])
  @@index([organization])
  @@index([city])
  @@index([country])
  @@map("alumni_profiles")
}

/**
 * |--------------------------------------------------------------------------
 * | Batch
 * |--------------------------------------------------------------------------
 */

model Batch {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  description String? @db.Text

  startYear Int? @map("start_year")
  endYear   Int? @map("end_year")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  alumniProfiles AlumniProfile[]

  @@index([name])
  @@index([startYear])
  @@index([endYear])
  @@index([isActive])
  @@map("batches")
}

/**
 * |--------------------------------------------------------------------------
 * | Event
 * |--------------------------------------------------------------------------
 */

model Event {
  id String @id @default(uuid()) @db.Uuid

  // Basic Information
  title       String @db.VarChar(200)
  slug        String @unique @db.VarChar(220)
  description String @db.Text

  // Media
  coverImageUrl String? @map("cover_image_url") @db.VarChar(500)

  // Classification
  category String @db.VarChar(100)

  // Schedule
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  // Physical Location
  venue    String? @db.VarChar(200)
  location String? @db.VarChar(300)

  // Online Event
  isOnline  Boolean @default(false) @map("is_online")
  onlineUrl String? @map("online_url") @db.VarChar(500)

  // Capacity
  capacity Int?

  // Registration
  registrationDeadline DateTime? @map("registration_deadline")

  // Organizer
  organizerId String @map("organizer_id") @db.Uuid

  // Status
  status EventStatus @default(DRAFT)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organizer     User                @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  registrations EventRegistration[]

  @@index([status])
  @@index([category])
  @@index([startsAt])
  @@index([organizerId])
  @@map("events")
}

/**
 * |--------------------------------------------------------------------------
 * | Event Registration
 * |--------------------------------------------------------------------------
 */

model EventRegistration {
  id String @id @default(uuid()) @db.Uuid

  eventId String @map("event_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  status RegistrationStatus @default(REGISTERED)

  registeredAt DateTime @default(now()) @map("registered_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can register only once for the same event
  @@unique([eventId, userId])
  // Indexes
  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@map("event_registrations")
}

model Memory {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  title     String   @db.VarChar(200)
  content   String   @db.Text
  imageUrl  String?  @map("image_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([createdAt])
  @@map("memories")
}
